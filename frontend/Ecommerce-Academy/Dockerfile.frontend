#  Etapa 1: CONSTRUCCIÓN 
FROM node:22-alpine AS builder
# Usa Node.js 18 sobre Alpine Linux como base para compilar el proyecto React.
WORKDIR /app
# Define /app como directorio de trabajo.
COPY package*.json ./
# Copia package.json y package-lock.json PRIMERO para aprovechar la caché de Docker. Si las dependencias no cambian, no se reinstalan.
RUN npm ci
# Instala dependencias con npm ci (más rápido y determinista que npm install; usa el lockfile exacto).
COPY . .
# Copia el resto del código fuente (src/, public/, vite.config.ts, etc.).
RUN npm run build
# Ejecuta la compilación de producción. Vite genera los archivos estáticos en la carpeta /app/dist.


#  Etapa 2: SERVIDOR WEB (Nginx) 
FROM nginx:alpine
# Usa Nginx sobre Alpine como servidor web para servir los archivos estáticos. Muy ligero (~25 MB).
COPY --from=builder /app/dist /usr/share/nginx/html
# Copia la carpeta dist (build de producción) al directorio que Nginx sirve por defecto.
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Copia una configuración personalizada de Nginx (la crearás en el paso 5).
EXPOSE 80
# El servidor Nginx escucha en el puerto 80 (HTTP estándar).
CMD ["nginx", "-g", "daemon off;"]
# Inicia Nginx en primer plano (daemon off es necesario para que Docker no cierre el contenedor).